# web-idea

WEBIDEA_LISTEN=127.0.0.1:8080
WEBIDEA_AUTH_MODE=dev
WEBIDEA_DEV_TOKEN=dev-token-change-me
WEBIDEA_JDTLS_XMX=1g
WEBIDEA_MAX_FILE_BYTES=2097152
WEBIDEA_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174
# Optional built apps/web directory served by the Gateway (relative asset base).
# WEBIDEA_STATIC_DIR=/absolute/path/to/apps/web/dist

# P2 Java LSP (optional). Empty = fs-only browse, no references.
# WEBIDEA_JDTLS_LAUNCH=/absolute/path/to/apps/jdtls-sidecar/bin/launch.sh
# WEBIDEA_JDTLS_DATA=/absolute/path/to/var/jdtls-data
# WEBIDEA_JDTLS_HOME=/absolute/path/to/apps/jdtls-sidecar/dist

# apps/web (optional)
# VITE_GATEWAY_URL=http://127.0.0.1:8080
# VITE_DEV_TOKEN=dev-token-change-me
# VITE_DEFAULT_ROOT=/absolute/path/to/project
