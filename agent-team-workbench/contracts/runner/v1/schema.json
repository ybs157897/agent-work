{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbench.example/contracts/runner/v1/schema.json",
  "title": "Runner WSS Protocol v1",
  "description": "Control Plane ↔ Go Runner 双向 WSS 信封（协议文档 §7）。连接端点 wss://control/runner/v1/connect，Bearer runner-service-token。Runner 对事件分配 runner_seq 等待 ACK；控制平面按 run_id+runner_seq 去重后分配 canonical run_seq。fencing_token 单调递增，旧连接恢复不可写。",
  "$defs": {
    "Envelope": {
      "type": "object",
      "required": ["v", "message_id", "kind", "method", "runner_id", "sent_at"],
      "properties": {
        "v": { "const": 1 },
        "message_id": { "type": "string", "pattern": "^msg_" },
        "kind": { "enum": ["request", "response", "event", "ack"] },
        "method": { "type": "string", "$comment": "见下方 method 白名单" },
        "runner_id": { "type": "string" },
        "run_id": { "type": ["string", "null"] },
        "reply_to": { "type": ["string", "null"] },
        "sent_at": { "type": "string", "format": "date-time" },
        "payload": { "type": ["object", "null"] }
      }
    },
    "RunnerHelloPayload": {
      "type": "object",
      "required": ["protocol_versions", "runner_version", "slots", "adapters"],
      "properties": {
        "protocol_versions": { "type": "array", "items": { "type": "integer" } },
        "runner_version": { "type": "string" },
        "os": { "type": "string" },
        "arch": { "type": "string" },
        "slots": { "type": "integer", "minimum": 1 },
        "adapters": {
          "type": "array",
          "items": { "$ref": "#/$defs/AdapterManifestRef" },
          "description": "本机可用 Adapter manifests 与 capability digests"
        }
      }
    },
    "ServerWelcomePayload": {
      "type": "object",
      "required": ["selected_version", "heartbeat_interval_seconds"],
      "properties": {
        "selected_version": { "type": "integer" },
        "heartbeat_interval_seconds": { "type": "integer", "minimum": 1 },
        "lease_policy": {
          "type": "object",
          "properties": {
            "ttl_seconds": { "type": "integer" },
            "renew_interval_seconds": { "type": "integer" }
          }
        },
        "max_frame_bytes": { "type": "integer", "minimum": 1024 }
      }
    },
    "RunOfferPayload": {
      "type": "object",
      "required": ["lease_id", "fencing_token", "run_spec"],
      "properties": {
        "lease_id": { "type": "string" },
        "fencing_token": { "type": "integer", "minimum": 1 },
        "run_spec": {
          "type": "object",
          "description": "canonical runtime Start 请求，见 contracts/runtime/v1",
          "required": ["run_id", "adapter_id", "input"],
          "properties": {
            "run_id": { "type": "string" },
            "adapter_id": { "type": "string" },
            "workspace_alias": { "type": "string", "description": "Runner 本地解析为授权根目录；禁止携带宿主任意绝对路径" },
            "capability_snapshot": { "type": "object" },
            "input": { "type": "object" },
            "policy": {
              "type": "object",
              "description": "Run 启动时固化的 sandbox / 工具白名单 / 网络策略 / approval_policy",
              "properties": {
                "sandbox": { "type": "string" },
                "tool_allowlist": { "type": "array", "items": { "type": "string" } },
                "network_policy": { "type": "string" },
                "approval_policy": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "RunAcceptPayload": {
      "type": "object",
      "required": ["accepted"],
      "properties": {
        "accepted": { "type": "boolean" },
        "reason": { "type": "string", "description": "拒绝原因：capacity / capability / workspace" }
      }
    },
    "RunCommandPayload": {
      "type": "object",
      "required": ["command_id", "command"],
      "properties": {
        "command_id": { "type": "string" },
        "command": { "enum": ["input", "interrupt", "cancel", "approval.resolve"] },
        "fencing_token": { "type": "integer" },
        "body": { "type": "object" }
      }
    },
    "RunEventPayload": {
      "type": "object",
      "required": ["runner_seq", "event"],
      "properties": {
        "runner_seq": { "type": "integer", "minimum": 1 },
        "provider_cursor": { "type": ["string", "null"] },
        "event": { "type": "object", "description": "canonical candidate event，见 contracts/runtime/v1；run.session 事件的 data 形态见 $defs/SessionEventData", "$comment": "run.session 必须携带全量 SessionUpdate 语义（clear 墓碑 / params 私有参数），旧 runner 缺省 clear=false、params 为空" },
        "raw_ref": { "type": ["string", "null"], "description": "Provider 原始载荷引用 raw://..." }
      }
    },
    "SessionEventData": {
      "type": "object",
      "description": "run.session 事件的 data 形态（与 runtime SessionUpdate 对齐）。clear=true 表示会话锚点墓碑（task_sessions 清理）；params 为 adapter 私有 resume 参数，跨进程持久化。",
      "properties": {
        "session_ref": { "type": "string", "description": "会话句柄；clear=true 时可为空" },
        "display_id": { "type": "string" },
        "clear": { "type": "boolean", "default": false },
        "clear_reason": { "type": "string" },
        "params": { "type": "object", "additionalProperties": true }
      }
    },
    "ArtifactManifestPayload": {
      "type": "object",
      "required": ["artifact_id", "sha256", "size", "logical_path"],
      "properties": {
        "artifact_id": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size": { "type": "integer", "minimum": 0 },
        "mime": { "type": "string" },
        "logical_path": { "type": "string" },
        "classification": { "type": "string" },
        "upload_ref": { "type": "string", "description": "对象存储上传引用；文件内容不进 WSS 帧" }
      }
    },
    "AckPayload": {
      "type": "object",
      "required": ["contiguous_seq"],
      "properties": {
        "contiguous_seq": { "type": "integer", "description": "已确认的最高连续 runner_seq" },
        "lease_renewed_until": { "type": ["string", "null"], "format": "date-time" },
        "backpressure": { "enum": ["none", "slow", "pause"] }
      }
    },
    "AdapterManifestRef": {
      "type": "object",
      "required": ["adapter_id", "adapter_version", "schema_digest"],
      "properties": {
        "adapter_id": { "type": "string" },
        "adapter_version": { "type": "string" },
        "schema_digest": { "type": "string" }
      }
    }
  },
  "type": "object",
  "allOf": [{ "$ref": "#/$defs/Envelope" }],
  "$comment": "method 白名单：runner→server: runner.hello / run.accept / run.reject / run.event / artifact.manifest / ack / heartbeat；server→runner: server.welcome / run.offer / run.command / ack / heartbeat。不兼容协议版本在 hello 阶段拒绝连接，运行中不隐式升级。"
}
